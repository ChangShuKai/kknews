SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
GOOGLE_CLIENT_ID=YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
GOOGLE_FORM_API_KEY=YOUR-GOOGLE-FORM-API-KEY
GOOGLE_FORM_ACTION_URL=
GOOGLE_FORM_CSV_URL=
BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@sixstarculture.com
# 用 node hash-password.js <密碼> 產生以下三項
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
# 必填：必須訪問 /adminusercontrol?k=<此值> 才看得到登入頁，否則一律 404
ADMIN_ACCESS_KEY=
# Cloudflare Turnstile 人機驗證 Secret Key（請在 Vercel 環境變數填寫）
TURNSTILE_SECRET_KEY=

# 選填：DFC 影片防暴雷預設授權觀看名單（逗號分隔，支援完整信箱或萬用字元如 112*@hlc.edu.tw，亦可直接於後台或資料庫設定）
DFC_ALLOWED_EMAILS=
# 選填：DFC 預設觀看權限模式（whitelist=僅規定帳號可看防暴雷, all_school=全校開放, closed=全面封閉）
DFC_ACCESS_MODE=whitelist
