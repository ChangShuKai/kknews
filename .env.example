SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR-SERVICE-ROLE-KEY
GOOGLE_CLIENT_ID=YOUR-GOOGLE-CLIENT-ID.apps.googleusercontent.com
# 選填（已原生整合 Supabase 資料表，無需 Google Form）：
# GOOGLE_FORM_API_KEY=
# GOOGLE_FORM_ACTION_URL=
# GOOGLE_FORM_CSV_URL=
BASE_URL=http://localhost:3000
ADMIN_EMAIL=admin@sixstarculture.com
# 用 node hash-password.js <密碼> 產生以下二項
ADMIN_PASSWORD_HASH=
SESSION_SECRET=

# 【新版 2FA 安全防護】新裝置登入強制傳送一次性驗證碼 (OTP) 至中央主管信箱
# 預設即為 kai1010210@gmail.com（每個裝置僅需驗證一次，通過即自動信任）
ADMIN_OTP_EMAIL=kai1010210@gmail.com

# 【郵件發送設定 (選填)】可選擇設定 Gmail 應用程式密碼或 Resend API 金鑰以自動寄信至 Gmail：
# 方式 A：Gmail SMTP（建議，免額外註冊）
# 於 Google 帳戶啟用兩步驟驗證並產生 16 位「應用程式密碼」：
# SMTP_USER=kai1010210@gmail.com
# SMTP_PASS=xxxx xxxx xxxx xxxx
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# 方式 B：Resend API
# RESEND_API_KEY=re_xxxxxxxxxxxx
# RESEND_FROM_EMAIL=KKNews 安全中心 <onboarding@resend.dev>

# 【已廢棄/選填】：已取消 k=XXX 金鑰限制，訪問 /adminusercontrol 即可直接顯示登入頁
ADMIN_ACCESS_KEY=

# Cloudflare Turnstile 人機驗證 Secret Key（請在 Vercel 環境變數填寫）
TURNSTILE_SECRET_KEY=

# 選填：DFC 影片防暴雷預設授權觀看名單（逗號分隔，支援完整信箱或萬用字元如 112*@hlc.edu.tw，亦可直接於後台或資料庫設定）
DFC_ALLOWED_EMAILS=
# 選填：DFC 預設觀看權限模式（whitelist=僅規定帳號可看防暴雷, all_school=全校開放, closed=全面封閉）
DFC_ACCESS_MODE=whitelist
